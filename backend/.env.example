# --- Application ---
APP_NAME=Smart Hiring Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# "json" for structured, log-aggregator-friendly output in a real deploy;
# anything else stays human-readable for a local terminal.
LOG_FORMAT=text

# --- Database (async PostgreSQL with pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_hiring

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Providers ---
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk-your-groq-key

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=smart-hiring-uploads

# --- SendGrid (report sharing + shortlist notifications, Modules 6/8) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=reports@smart-hiring.example

# --- MLOps (Module 7) ---
# mlflow>=3's filesystem backend is in maintenance mode; sqlite is the modern default.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- MLOps scheduled checks ---
# When enabled, runs the same RAGAS eval + drift check as the /analytics page's
# manual "Run" buttons on a recurring background schedule, and posts a Slack
# alert (via SLACK_WEBHOOK_URL below) on any threshold breach.
MLOPS_SCHEDULE_ENABLED=false
MLOPS_SCHEDULE_INTERVAL_HOURS=24
MLOPS_SCHEDULE_RAGAS_SAMPLE_SIZE=5

# --- Auth (Module 8) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=mysecretkey
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Notifications (Module 8) ---
SLACK_WEBHOOK_URL=

# --- Rate limiting (per client IP, backed by Redis) ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_FORGOT_PASSWORD=3/hour
RATE_LIMIT_LLM_ENDPOINTS=10/minute

# Hard daily cap (UTC) on total LLM spend in USD. 0 = disabled. Once hit, new
# LLM calls raise instead of running up the bill further — see llm_router.py.
LLM_DAILY_BUDGET_USD=0

# Used to build links in outbound emails (e.g. the password reset link).
FRONTEND_URL=http://localhost:3000

# --- Interview WS voice loop (Module 5) ---
# How long with no detected candidate speech before nudging them, then giving up.
INTERVIEW_WS_NUDGE_SECONDS=20
INTERVIEW_WS_TIMEOUT_SECONDS=45
INTERVIEW_WS_POLL_SECONDS=5

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
